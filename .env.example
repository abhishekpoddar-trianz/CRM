# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=crm-data-storage

# Database Configuration (use AWS RDS endpoint)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=crm
DB_USERNAME=admin
DB_PASSWORD=your-secure-password

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MIN_IDLE=5
DB_IDLE_TIMEOUT=300000
DB_CONNECTION_TIMEOUT=20000
DB_MAX_LIFETIME=1200000
DB_LEAK_DETECTION=60000

# Application Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=cloud
LOG_LEVEL=INFO
DDL_AUTO=validate

# CSV Export Limits
CSV_MAX_RECORDS=10000
CSV_PAGE_SIZE=1000

# Data Source Configuration
DATA_SOURCE=s3

# Security and Management
MANAGEMENT_SECURITY_ENABLED=true
MANAGEMENT_CONTEXT_PATH=/actuator
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
HEALTH_SHOW_DETAILS=when-authorized

# CloudWatch Monitoring
CLOUDWATCH_METRICS_ENABLED=true

# Thymeleaf Configuration
THYMELEAF_MODE=HTML
THYMELEAF_CACHE=true
THYMELEAF_ENCODING=UTF-8

# JPA Configuration
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false